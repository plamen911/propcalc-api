# Placeholder defaults so the kernel can boot where no .env exists (CI).
#
# This repository gitignores .env, and Symfony's Dotenv throws when neither .env
# nor .env.dist is present. These are placeholders, NOT real values - locally
# .env takes precedence and this file is ignored entirely.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=placeholder_override_me

DATABASE_URL="mysql://user:password@127.0.0.1:3306/propcalc?serverVersion=8.4&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=placeholder_override_me

MAILER_DSN=null://null
