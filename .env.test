# Test environment defaults.
#
# THROWAWAY VALUES ONLY. Never put real credentials, the Brevo API key, or the
# production JWT passphrase in this file - it is committed to the repository.
# Machine-specific overrides belong in .env.test.local, which is gitignored.

KERNEL_CLASS='App\Kernel'

APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_app_secret_not_used_for_anything_real

# A dedicated throwaway database. The name MUST end in "_test": tests/bootstrap.php
# refuses to drop or create a schema for any other database, so a stray DATABASE_URL
# can never destroy the development or production data.
DATABASE_URL="mysql://root:@127.0.0.1:3306/propcalc_test?serverVersion=8.4&charset=utf8mb4"

# Never send mail from tests. Messages are collected in memory and asserted on.
MAILER_DSN=null://null

# Test-only RSA keys, generated by bin/setup-test-db.sh into var/jwt/ (gitignored).
# Their paths are set in the when@test block of lexik_jwt_authentication.yaml, because
# that bundle takes the key paths from config, not from the environment - only the
# passphrase is env-driven.
JWT_PASSPHRASE=testpassphrase
